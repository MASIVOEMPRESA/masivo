# Telegram
TELEGRAM_BOT_TOKEN=
# Uno o varios chat IDs separados por coma
TELEGRAM_CHAT_ID=

# Proyecto donde trabaja OpenCode
PROJECT_DIR=/Users/ividella/Desktop/masivoweb

# Binario de OpenCode
OPENCODE_BIN=/Users/ividella/.local/bin/opencode

# Modelo opcional: proveedor/modelo (ej. opencode/claude-sonnet-4-5)
MODEL=

# Agente opcional (por defecto usa el agente configurado, normalmente build)
AGENT=

# 1 = auto-aprueba comandos y ediciones; 0 = quedan esperando aprobación manual
AUTO_APPROVE=1

# Máximo de caracteres que devuelve por Telegram
MAX_OUTPUT=9000
